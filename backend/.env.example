# Copiar a .env y ajustar. NUNCA subir .env al repositorio.
NODE_ENV=development
PORT=3000

# Usuario/clave de MySQL según su instalación local
DATABASE_URL="mysql://root:password@localhost:3306/laboratorio_bacteriologico"

# Mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET="cambie-este-secreto-por-uno-generado-con-openssl-rand-hex-32"
JWT_EXPIRES_IN_SECONDS=28800

BCRYPT_ROUNDS=12
CORS_ORIGIN="http://localhost:5173"
