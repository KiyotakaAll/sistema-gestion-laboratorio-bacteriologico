// Mapeo 1:1 de database/schema.sql.
// Flujo de trabajo: 1) ejecutar schema.sql en MySQL  2) `npm run prisma:generate`.
// NO se usa `prisma migrate`: la fuente de verdad del modelo es el DDL SQL.
// Las acciones referenciales (onDelete/onUpdate) se declaran explícitamente para
// que coincidan con las FK reales (NO ACTION por defecto, CASCADE y SET NULL donde aplica).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Sexo {
  M
  F
  O
}

enum Prioridad {
  RUTINA
  URGENTE
}

enum EstadoMuestra {
  REGISTRADA
  RECEPTADA
  EN_PROCESAMIENTO
  PROCESADA
  RECHAZADA
}

enum EstadoResultado {
  PENDIENTE_VALIDACION
  VALIDADO
}

enum Sensibilidad {
  S
  I
  R
}

model Rol {
  id          Int    @id @default(autoincrement()) @db.UnsignedInt
  nombre      String @unique @db.VarChar(30)
  descripcion String @db.VarChar(150)

  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  rolId          Int       @map("rol_id") @db.UnsignedInt
  username       String    @unique @db.VarChar(40)
  email          String    @unique @db.VarChar(120)
  nombreCompleto String    @map("nombre_completo") @db.VarChar(120)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  activo         Boolean   @default(true)
  ultimoAcceso   DateTime? @map("ultimo_acceso") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  rol                    Rol          @relation(fields: [rolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  solicitudesRegistradas Solicitud[]
  muestrasRecepcionadas  Muestra[]
  resultadosRegistrados  Resultado[]  @relation("ResultadoRegistra")
  resultadosValidados    Resultado[]  @relation("ResultadoValida")
  logs                   LogAuditoria[]

  @@index([rolId], map: "idx_usuarios_rol")
  @@map("usuarios")
}

model Paciente {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  cedula          String   @unique @db.VarChar(20)
  nombres         String   @db.VarChar(80)
  apellidos       String   @db.VarChar(80)
  fechaNacimiento DateTime @map("fecha_nacimiento") @db.Date
  sexo            Sexo
  telefono        String?  @db.VarChar(20)
  email           String?  @db.VarChar(120)
  direccion       String?  @db.VarChar(200)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  solicitudes Solicitud[]

  @@index([apellidos, nombres], map: "idx_pacientes_apellidos_nombres")
  @@index([createdAt], map: "idx_pacientes_created_at")
  @@map("pacientes")
}

model Solicitud {
  id                    Int       @id @default(autoincrement()) @db.UnsignedInt
  codigo                String    @unique @db.VarChar(20)
  pacienteId            Int       @map("paciente_id") @db.UnsignedInt
  usuarioIdRegistra     Int       @map("usuario_id_registra") @db.UnsignedInt
  medicoSolicitante     String?   @map("medico_solicitante") @db.VarChar(120)
  diagnosticoPresuntivo String?   @map("diagnostico_presuntivo") @db.VarChar(255)
  prioridad             Prioridad @default(RUTINA)
  fechaSolicitud        DateTime  @default(now()) @map("fecha_solicitud") @db.DateTime(3)
  observaciones         String?   @db.VarChar(255)
  createdAt             DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  paciente    Paciente  @relation(fields: [pacienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registradoPor Usuario @relation(fields: [usuarioIdRegistra], references: [id], onDelete: NoAction, onUpdate: NoAction)
  muestras    Muestra[]

  @@index([pacienteId], map: "idx_solicitudes_paciente")
  @@index([fechaSolicitud], map: "idx_solicitudes_fecha")
  @@index([usuarioIdRegistra], map: "idx_solicitudes_registra")
  @@map("solicitudes")
}

model Examen {
  id                   Int     @id @default(autoincrement()) @db.UnsignedInt
  codigo               String  @unique @db.VarChar(20)
  nombre               String  @db.VarChar(120)
  tipoMuestraRequerida String  @map("tipo_muestra_requerida") @db.VarChar(60)
  descripcion          String? @db.VarChar(255)
  precio               Decimal @default(0.00) @db.Decimal(10, 2)
  activo               Boolean @default(true)

  muestraExamenes MuestraExamen[]

  @@index([nombre], map: "idx_examenes_nombre")
  @@map("examenes")
}

model Muestra {
  id                  Int           @id @default(autoincrement()) @db.UnsignedInt
  codigoBarras        String        @unique @map("codigo_barras") @db.VarChar(30)
  solicitudId         Int           @map("solicitud_id") @db.UnsignedInt
  tipoMuestra         String        @map("tipo_muestra") @db.VarChar(60)
  sitioAnatomico      String?       @map("sitio_anatomico") @db.VarChar(80)
  estado              EstadoMuestra @default(REGISTRADA)
  fechaToma           DateTime      @map("fecha_toma") @db.DateTime(3)
  fechaRecepcion      DateTime?     @map("fecha_recepcion") @db.DateTime(3)
  fechaProcesamiento  DateTime?     @map("fecha_procesamiento") @db.DateTime(3)
  usuarioIdRecepciona Int?          @map("usuario_id_recepciona") @db.UnsignedInt
  motivoRechazo       String?       @map("motivo_rechazo") @db.VarChar(255)
  createdAt           DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  solicitud      Solicitud       @relation(fields: [solicitudId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recepcionadoPor Usuario?       @relation(fields: [usuarioIdRecepciona], references: [id], onDelete: NoAction, onUpdate: NoAction)
  examenes       MuestraExamen[]

  @@index([solicitudId], map: "idx_muestras_solicitud")
  @@index([estado], map: "idx_muestras_estado")
  @@index([fechaToma], map: "idx_muestras_fecha_toma")
  @@index([usuarioIdRecepciona], map: "idx_muestras_recepciona")
  @@map("muestras")
}

model MuestraExamen {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  muestraId Int      @map("muestra_id") @db.UnsignedInt
  examenId  Int      @map("examen_id") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  muestra   Muestra    @relation(fields: [muestraId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  examen    Examen     @relation(fields: [examenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resultado Resultado?

  @@unique([muestraId, examenId], map: "uq_muestra_examen")
  @@index([examenId], map: "idx_muestra_examen_examen")
  @@map("muestra_examen")
}

model Resultado {
  id                Int             @id @default(autoincrement()) @db.UnsignedInt
  muestraExamenId   Int             @unique @map("muestra_examen_id") @db.UnsignedInt
  usuarioIdRegistra Int             @map("usuario_id_registra") @db.UnsignedInt
  hallazgoGram      String?         @map("hallazgo_gram") @db.Text
  colonias          String?         @db.Text
  bacteriaAislada   String?         @map("bacteria_aislada") @db.VarChar(150)
  observaciones     String?         @db.Text
  estado            EstadoResultado @default(PENDIENTE_VALIDACION)
  fechaRegistro     DateTime        @default(now()) @map("fecha_registro") @db.DateTime(3)
  usuarioIdValida   Int?            @map("usuario_id_valida") @db.UnsignedInt
  fechaValidacion   DateTime?       @map("fecha_validacion") @db.DateTime(3)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  muestraExamen MuestraExamen            @relation(fields: [muestraExamenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registradoPor Usuario                  @relation("ResultadoRegistra", fields: [usuarioIdRegistra], references: [id], onDelete: NoAction, onUpdate: NoAction)
  validadoPor   Usuario?                 @relation("ResultadoValida", fields: [usuarioIdValida], references: [id], onDelete: NoAction, onUpdate: NoAction)
  antibiograma  ResultadoAntibiograma[]

  @@index([estado], map: "idx_resultados_estado")
  @@index([fechaRegistro], map: "idx_resultados_fecha_registro")
  @@index([fechaValidacion], map: "idx_resultados_fecha_validacion")
  @@index([usuarioIdRegistra], map: "idx_resultados_registra")
  @@index([usuarioIdValida], map: "idx_resultados_valida")
  @@map("resultados")
}

model ResultadoAntibiograma {
  id           Int          @id @default(autoincrement()) @db.UnsignedInt
  resultadoId  Int          @map("resultado_id") @db.UnsignedInt
  antibiotico  String       @db.VarChar(80)
  sensibilidad Sensibilidad
  haloMm       Decimal?     @map("halo_mm") @db.Decimal(5, 1)

  resultado Resultado @relation(fields: [resultadoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([resultadoId, antibiotico], map: "uq_antibiograma_resultado_antibiotico")
  @@map("resultado_antibiograma")
}

model LogAuditoria {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  usuarioId      Int?     @map("usuario_id") @db.UnsignedInt
  entidad        String   @db.VarChar(40)
  entidadId      Int      @map("entidad_id") @db.UnsignedInt
  accion         String   @db.VarChar(40)
  estadoAnterior String?  @map("estado_anterior") @db.VarChar(30)
  estadoNuevo    String?  @map("estado_nuevo") @db.VarChar(30)
  detalle        Json?
  ipOrigen       String?  @map("ip_origen") @db.VarChar(45)
  fechaEvento    DateTime @default(now()) @map("fecha_evento") @db.DateTime(3)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([entidad, entidadId], map: "idx_logs_entidad")
  @@index([usuarioId], map: "idx_logs_usuario")
  @@index([fechaEvento], map: "idx_logs_fecha")
  @@map("logs_auditoria")
}
