generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Rol {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  nombre      String    @unique(map: "uq_roles_nombre") @db.VarChar(30)
  descripcion String    @db.VarChar(150)
  usuarios    Usuario[]

  @@map("roles")
}

model Usuario {
  id                     Int            @id @default(autoincrement()) @db.UnsignedInt
  rolId                  Int            @map("rol_id") @db.UnsignedInt
  username               String         @unique(map: "uq_usuarios_username") @db.VarChar(40)
  email                  String         @unique(map: "uq_usuarios_email") @db.VarChar(120)
  nombreCompleto         String         @map("nombre_completo") @db.VarChar(120)
  passwordHash           String         @map("password_hash") @db.VarChar(255)
  activo                 Boolean        @default(true)
  ultimoAcceso           DateTime?      @map("ultimo_acceso")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @default(now()) @updatedAt @map("updated_at")
  logs                   LogAuditoria[]
  muestrasRecepcionadas  Muestra[]
  resultadosRegistrados  Resultado[]    @relation("ResultadoRegistra")
  resultadosValidados    Resultado[]    @relation("ResultadoValida")
  solicitudesRegistradas Solicitud[]
  rol                    Rol            @relation(fields: [rolId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuarios_rol")

  @@index([rolId], map: "idx_usuarios_rol")
  @@map("usuarios")
}

model Paciente {
  id              Int         @id @default(autoincrement()) @db.UnsignedInt
  cedula          String      @unique(map: "uq_pacientes_cedula") @db.VarChar(20)
  nombres         String      @db.VarChar(80)
  apellidos       String      @db.VarChar(80)
  fechaNacimiento DateTime    @map("fecha_nacimiento") @db.Date
  sexo            Sexo
  telefono        String?     @db.VarChar(20)
  email           String?     @db.VarChar(120)
  direccion       String?     @db.VarChar(200)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at")
  solicitudes     Solicitud[]

  @@index([apellidos, nombres], map: "idx_pacientes_apellidos_nombres")
  @@index([createdAt], map: "idx_pacientes_created_at")
  @@map("pacientes")
}

model Solicitud {
  id                    Int       @id @default(autoincrement()) @db.UnsignedInt
  codigo                String    @unique(map: "uq_solicitudes_codigo") @db.VarChar(20)
  pacienteId            Int       @map("paciente_id") @db.UnsignedInt
  usuarioIdRegistra     Int       @map("usuario_id_registra") @db.UnsignedInt
  medicoSolicitante     String?   @map("medico_solicitante") @db.VarChar(120)
  diagnosticoPresuntivo String?   @map("diagnostico_presuntivo") @db.VarChar(255)
  prioridad             Prioridad @default(RUTINA)
  fechaSolicitud        DateTime  @default(now()) @map("fecha_solicitud")
  observaciones         String?   @db.VarChar(255)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  muestras              Muestra[]
  paciente              Paciente  @relation(fields: [pacienteId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_solicitudes_paciente")
  registradoPor         Usuario   @relation(fields: [usuarioIdRegistra], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_solicitudes_usuario_registra")

  @@index([pacienteId], map: "idx_solicitudes_paciente")
  @@index([fechaSolicitud], map: "idx_solicitudes_fecha")
  @@index([usuarioIdRegistra], map: "idx_solicitudes_registra")
  @@map("solicitudes")
}

model Examen {
  id                   Int             @id @default(autoincrement()) @db.UnsignedInt
  codigo               String          @unique(map: "uq_examenes_codigo") @db.VarChar(20)
  nombre               String          @db.VarChar(120)
  tipoMuestraRequerida String          @map("tipo_muestra_requerida") @db.VarChar(60)
  descripcion          String?         @db.VarChar(255)
  precio               Decimal         @default(0.00) @db.Decimal(10, 2)
  activo               Boolean         @default(true)
  muestraExamenes      MuestraExamen[]

  @@index([nombre], map: "idx_examenes_nombre")
  @@map("examenes")
}

model Muestra {
  id                  Int             @id @default(autoincrement()) @db.UnsignedInt
  codigoBarras        String          @unique(map: "uq_muestras_codigo_barras") @map("codigo_barras") @db.VarChar(30)
  solicitudId         Int             @map("solicitud_id") @db.UnsignedInt
  tipoMuestra         String          @map("tipo_muestra") @db.VarChar(60)
  sitioAnatomico      String?         @map("sitio_anatomico") @db.VarChar(80)
  estado              EstadoMuestra   @default(REGISTRADA)
  fechaToma           DateTime        @map("fecha_toma")
  fechaRecepcion      DateTime?       @map("fecha_recepcion")
  fechaProcesamiento  DateTime?       @map("fecha_procesamiento")
  usuarioIdRecepciona Int?            @map("usuario_id_recepciona") @db.UnsignedInt
  motivoRechazo       String?         @map("motivo_rechazo") @db.VarChar(255)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at")
  examenes            MuestraExamen[]
  solicitud           Solicitud       @relation(fields: [solicitudId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_muestras_solicitud")
  recepcionadoPor     Usuario?        @relation(fields: [usuarioIdRecepciona], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_muestras_usuario_recepciona")

  @@index([solicitudId], map: "idx_muestras_solicitud")
  @@index([estado], map: "idx_muestras_estado")
  @@index([fechaToma], map: "idx_muestras_fecha_toma")
  @@index([usuarioIdRecepciona], map: "idx_muestras_recepciona")
  @@map("muestras")
}

model MuestraExamen {
  id        Int        @id @default(autoincrement()) @db.UnsignedInt
  muestraId Int        @map("muestra_id") @db.UnsignedInt
  examenId  Int        @map("examen_id") @db.UnsignedInt
  createdAt DateTime   @default(now()) @map("created_at")
  examen    Examen     @relation(fields: [examenId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_muestra_examen_examen")
  muestra   Muestra    @relation(fields: [muestraId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_muestra_examen_muestra")
  resultado Resultado?

  @@unique([muestraId, examenId], map: "uq_muestra_examen")
  @@index([examenId], map: "idx_muestra_examen_examen")
  @@map("muestra_examen")
}

model Resultado {
  id                Int                     @id @default(autoincrement()) @db.UnsignedInt
  muestraExamenId   Int                     @unique(map: "uq_resultados_muestra_examen") @map("muestra_examen_id") @db.UnsignedInt
  usuarioIdRegistra Int                     @map("usuario_id_registra") @db.UnsignedInt
  hallazgoGram      String?                 @map("hallazgo_gram") @db.Text
  colonias          String?                 @db.Text
  bacteriaAislada   String?                 @map("bacteria_aislada") @db.VarChar(150)
  observaciones     String?                 @db.Text
  estado            EstadoResultado         @default(PENDIENTE_VALIDACION)
  fechaRegistro     DateTime                @default(now()) @map("fecha_registro")
  usuarioIdValida   Int?                    @map("usuario_id_valida") @db.UnsignedInt
  fechaValidacion   DateTime?               @map("fecha_validacion")
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at")
  antibiograma      ResultadoAntibiograma[]
  muestraExamen     MuestraExamen           @relation(fields: [muestraExamenId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_resultados_muestra_examen")
  registradoPor     Usuario                 @relation("ResultadoRegistra", fields: [usuarioIdRegistra], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_resultados_usuario_registra")
  validadoPor       Usuario?                @relation("ResultadoValida", fields: [usuarioIdValida], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_resultados_usuario_valida")

  @@index([estado], map: "idx_resultados_estado")
  @@index([fechaRegistro], map: "idx_resultados_fecha_registro")
  @@index([fechaValidacion], map: "idx_resultados_fecha_validacion")
  @@index([usuarioIdRegistra], map: "idx_resultados_registra")
  @@index([usuarioIdValida], map: "idx_resultados_valida")
  @@map("resultados")
}

model ResultadoAntibiograma {
  id           Int          @id @default(autoincrement()) @db.UnsignedInt
  resultadoId  Int          @map("resultado_id") @db.UnsignedInt
  antibiotico  String       @db.VarChar(80)
  sensibilidad Sensibilidad
  haloMm       Decimal?     @map("halo_mm") @db.Decimal(5, 1)
  resultado    Resultado    @relation(fields: [resultadoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_antibiograma_resultado")

  @@unique([resultadoId, antibiotico], map: "uq_antibiograma_resultado_antibiotico")
  @@map("resultado_antibiograma")
}

model LogAuditoria {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  usuarioId      Int?     @map("usuario_id") @db.UnsignedInt
  entidad        String   @db.VarChar(40)
  entidadId      Int      @map("entidad_id") @db.UnsignedInt
  accion         String   @db.VarChar(40)
  estadoAnterior String?  @map("estado_anterior") @db.VarChar(30)
  estadoNuevo    String?  @map("estado_nuevo") @db.VarChar(30)
  detalle        Json?
  ipOrigen       String?  @map("ip_origen") @db.VarChar(45)
  fechaEvento    DateTime @default(now()) @map("fecha_evento")
  usuario        Usuario? @relation(fields: [usuarioId], references: [id], onUpdate: NoAction, map: "fk_logs_usuario")

  @@index([entidad, entidadId], map: "idx_logs_entidad")
  @@index([usuarioId], map: "idx_logs_usuario")
  @@index([fechaEvento], map: "idx_logs_fecha")
  @@map("logs_auditoria")
}

enum Sexo {
  M
  F
  O
}

enum Prioridad {
  RUTINA
  URGENTE
}

enum EstadoMuestra {
  REGISTRADA
  RECEPTADA
  EN_PROCESAMIENTO
  PROCESADA
  RECHAZADA
}

enum EstadoResultado {
  PENDIENTE_VALIDACION
  VALIDADO
}

enum Sensibilidad {
  S
  I
  R
}
